rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function signedIn() { return request.auth != null; }
    function userDoc()  { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isOwner()  { return signedIn() && userDoc().role == 'owner'; }

    // ---- First-run setup doc ----
    // Public read so the login page can detect "first user". Anyone signed-in
    // can write it during bootstrap; owner locks it down after.
    match /config/setup {
      allow read:   if true;
      allow create: if true;
      allow update: if signedIn();
      allow delete: if isOwner();
    }

    // ---- Endpoint config ----
    match /config/endpoint {
      allow read:  if signedIn();
      allow write: if isOwner();
    }

    // ---- Referral codes ----
    // Public read is required so the signup form can validate a code
    // BEFORE the user is authenticated.
    match /referrals/{code} {
      allow read:   if true;
      allow create: if signedIn() || request.auth == null;
      allow update: if signedIn() && (
        isOwner() ||
        resource.data.ownerUid == request.auth.uid
      );
      allow delete: if signedIn() && (
        isOwner() ||
        resource.data.ownerUid == request.auth.uid
      );
    }

    // ---- Users ----
    // Public read for username-uniqueness checks + first-run detection.
    // Signed-in users may create their own doc. Role changes restricted.
    match /users/{uid} {
      allow read:   if true;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        isOwner() ||
        (request.auth.uid == uid && request.resource.data.role == resource.data.role)
      );
      allow delete: if isOwner();
    }

    // ---- Keys ----
    // Owner sees all, resellers see only their own.
    match /keys/{keyId} {
      allow read: if signedIn() && (
        isOwner() ||
        resource.data.createdBy == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && (
        isOwner() ||
        resource.data.createdBy == request.auth.uid
      );
    }
  }
}
